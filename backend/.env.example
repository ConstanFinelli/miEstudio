PORT=8080
DB_DRIVER=mysql
DB_USER=miestudio
DB_PASSWORD=miestudio123
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=miestudio
# Storage Driver: "local" (default) o "r2" (Cloudflare R2 / S3 compatible)
STORAGE_DRIVER=local
STORAGE_DIR=./uploads

# Configuración Cloudflare R2 (Requerido solo si STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=tu_account_id_de_cloudflare
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET_NAME=miestudio-materiales
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com (calculado automáticamente si R2_ACCOUNT_ID está presente)
# R2_PUBLIC_URL=https://materiales.tudominio.com (opcional)

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.8-flash

# Mailing & Password Reset (opcional para desarrollo local; sin SMTP se loguea en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=miEstudio <no-reply@miestudio.app>
FRONTEND_URL=http://localhost:5173

